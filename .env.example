# Copia este archivo a .env y configura los valores según tu entorno local

# Configuración de Base de Datos
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_contraseña_aqui
DATABASE_NAME=soyla

# Configuración de Seguridad
# ⚠️ IMPORTANTE: Genera una clave segura de al menos 32 caracteres para producción
JWT_SECRET=usa-una-clave-super-segura-de-32-caracteres-minimo

# Puerto de la aplicación
PORT=10000
